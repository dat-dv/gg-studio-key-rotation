<header>
  <h1>GG Studio · Gemini Key Pool</h1>
  <nav>
    {{#each pages}}
    <a href="/{{id}}"{{#if active}} class="active" aria-current="page"{{/if}}>{{label}}</a>
    {{/each}}
  </nav>
  <div class="spacer"></div>
  <button class="btn sm" id="exportBtn" title="Tải file JSON chứa key, limits, usage">Export</button>
  <button class="btn sm" id="importBtn" title="Nạp file backup (merge, không xoá dữ liệu đang có)">Import</button>
  <input type="file" id="importFile" accept="application/json,.json" hidden />
  <div id="clock"></div>
</header>
