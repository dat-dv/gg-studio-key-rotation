<div class="card">
  <div class="row" style="margin-bottom:8px"><h2 style="margin:0">Request log</h2><span class="hint" id="logsTotal"></span><div class="spacer"></div><button class="btn sm" id="reloadLogs">Tải lại</button></div>
  <div class="tablewrap"><table>
    <thead><tr><th>Thời gian</th><th>Client</th><th>Key Google</th><th>Model</th><th>Status</th><th>Tokens</th><th>Latency</th><th>Lỗi</th></tr></thead>
    <tbody id="logsBody"></tbody>
  </table></div>
  <div class="row" style="margin-top:10px">
    <select id="logsPageSize" style="width:auto" aria-label="Số dòng mỗi trang">
      <option value="50">50 / trang</option><option value="100">100 / trang</option><option value="200">200 / trang</option>
    </select>
    <div class="spacer"></div>
    <button class="btn sm" id="logsFirst">« Mới nhất</button>
    <button class="btn sm" id="logsPrev">‹ Trước</button>
    <span class="hint" id="logsPageInfo"></span>
    <button class="btn sm" id="logsNext">Sau ›</button>
    <button class="btn sm" id="logsLast">Cũ nhất »</button>
  </div>
</div>
