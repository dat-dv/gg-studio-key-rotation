# Dán các biến này vào Coolify: Application -> Environment Variables -> Developer view
# (bản có giá trị thật nằm ở .env.coolify, file đó không được commit)

# Bắt buộc: token vào UI / admin API (header x-admin-token)
ADMIN_TOKEN=change-me
# Bắt buộc: key chủ gọi proxy, dùng được mọi model
PROXY_TOKEN=sk-gg-master-change-me

# Cổng mở ra ngoài server (trong container app luôn chạy 3000)
HOST_PORT=4041
BIND_ADDR=0.0.0.0

# Số key tối đa thử cho 1 request
MAX_ATTEMPTS=4

# Địa chỉ hiện trong lệnh curl mẫu ở màn hình Client keys (tuỳ chọn, sửa được ngay trên UI)
# Domain public, vd https://gg.example.com — để trống thì lấy theo địa chỉ đang mở UI
PUBLIC_BASE_URL=
# Địa chỉ nội bộ cho service cùng docker network / cùng máy
LOCAL_BASE_URL=http://gg-studio:3000

# Docker network dùng chung với các stack khác trên cùng máy (phải tạo trước: docker network create proxy_net)
SHARED_NETWORK=proxy_net
