# ---- Docker (docker compose up) ----
# Cổng mở ra ngoài máy host; trong container app luôn chạy cổng 3000
HOST_PORT=4041
# 0.0.0.0 = máy khác trong mạng gọi được; 127.0.0.1 = chỉ máy host
BIND_ADDR=0.0.0.0

# ---- Chạy trực tiếp (npm run start:dev / npm start), Docker bỏ qua 2 biến này ----
PORT=3000
HOST=127.0.0.1
# Đường dẫn file SQLite
DB_PATH=./data/gg-studio.db
# Redis giữ bộ đếm quota + cooldown (bắt buộc). Docker compose tự trỏ vào service gg-redis.
REDIS_URL=redis://127.0.0.1:6379
# Nếu set: UI/admin API yêu cầu header x-admin-token
ADMIN_TOKEN=
# Nếu set: client gọi proxy phải gửi đúng token này ở x-goog-api-key hoặc ?key=
PROXY_TOKEN=
# Số key tối đa thử lại (failover) cho 1 request
MAX_ATTEMPTS=4
ROUTER_DEADLINE_MS=45000
MAX_INFLIGHT_PER_KEY=4
OVERLOAD_THRESHOLD=3
OVERLOAD_PAUSE_MS=15000
# Upstream
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Địa chỉ hiện trong lệnh curl mẫu ở màn hình Client keys (tuỳ chọn, sửa được ngay trên UI)
# Domain public, vd https://gg.example.com — để trống thì lấy theo địa chỉ đang mở UI
PUBLIC_BASE_URL=
# Địa chỉ nội bộ cho service cùng docker network / cùng máy
LOCAL_BASE_URL=http://gg-studio:3000

# Docker network dùng chung với các stack khác trên cùng máy (phải tạo trước: docker network create proxy_net)
SHARED_NETWORK=proxy_net
